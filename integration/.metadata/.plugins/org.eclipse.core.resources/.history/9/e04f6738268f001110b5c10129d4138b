#include "uart_task.h"
#include "shared_data.h"
#include "main.h"
#include <stdio.h>
#include <string.h>

extern UART_HandleTypeDef huart2;

void UART_Task(void *argument)
{
    char txBuffer[128];
    SystemData_t snap;

    printf("[UART] Task Started\r\n");

    for (;;)
    {
        /* Take snapshot of shared data */
        osMutexAcquire(dataMutexHandle, osWaitForever);
        snap = sysData;
        osMutexRelease(dataMutexHandle);

        /*
         * CSV Format:
         * Temperature,
         * Humidity,
         * Pressure,
         * Gas PPM,
         * Voltage,
         * Current,
         * Motion
         */

        sprintf(txBuffer,
                "%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%d\r\n",
                snap.bme.temperature,
                snap.bme.humidity,
                snap.bme.pressure,
                snap.mq135.ppm,
                snap.ina.voltage_V,
                snap.ina.current_A,
                snap.pir.zone_occupied);

        HAL_UART_Transmit(&huart2,
                          (uint8_t *)txBuffer,
                          strlen(txBuffer),
                          HAL_MAX_DELAY);

        osDelay(2000);      // Send every 2 seconds
    }
}
