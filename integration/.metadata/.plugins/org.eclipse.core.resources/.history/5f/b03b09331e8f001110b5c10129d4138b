#include "mqtt_task.h"
#include "shared_data.h"
#include "main.h"
#include <stdio.h>
#include <string.h>

extern UART_HandleTypeDef huart2;

void MQTT_Task(void *argument)
{
    char json[256];

    while(1)
    {
        osMutexAcquire(dataMutexHandle, osWaitForever);

        sprintf(json,
        "{\"temperature\":%.2f,"
        "\"humidity\":%.2f,"
        "\"pressure\":%.2f,"
        "\"gas\":%.2f,"
        "\"current\":%.2f,"
        "\"voltage\":%.2f,"
        "\"power\":%.2f,"
        "\"motion\":%d,"
        "\"event\":%lu}\r\n",

        sysData.bme.temperature,
        sysData.bme.humidity,
        sysData.bme.pressure,

        sysData.mq135.ppm,

        sysData.ina.current_A,
        sysData.ina.voltage_V,
        sysData.ina.power_W,

        sysData.pir.zone_occupied,
        sysData.pir.event_count);

        osMutexRelease(dataMutexHandle);

        HAL_UART_Transmit(&huart2,
                          (uint8_t *)json,
                          strlen(json),
                          HAL_MAX_DELAY);

        osDelay(2000);
    }
}
